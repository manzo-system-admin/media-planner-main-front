rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console > Firestore Database > Rules)
//
// Design notes:
// - All server-side reads (the public site's SSR pages, the backoffice session
//   check, the /api/admin/users route) go through firebase-admin, which
//   bypasses these rules entirely. These rules only govern requests made
//   directly from the browser: the Backoffice app.
// - Backoffice access only requires a signed-in Firebase Auth user.

function isSignedIn() {
  return request.auth != null;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Content collections editable by any signed-in backoffice user.
    match /{collection}/{docId} {
      allow read: if collection in [
        'banners', 'videoPopup', 'services', 'portfolio',
        'news', 'newsCategories', 'videoLibrary', 'eventGallery',
        'team', 'clients'
      ];
      allow write: if isSignedIn() && collection in [
        'banners', 'videoPopup', 'services', 'portfolio',
        'news', 'newsCategories', 'videoLibrary', 'eventGallery',
        'team', 'clients'
      ];
    }

    // Site-wide settings: signed-in write (still publicly readable, same
    // as the rest of the content collections above).
    match /{collection}/{docId} {
      allow read: if collection in ['siteSettings', 'aboutContent'];
      allow write: if isSignedIn() && collection in ['siteSettings', 'aboutContent'];
    }

    // Activity log: append-only audit trail of content changes made from the
    // Backoffice. Signed-in users can read and create entries; nothing may be
    // edited or deleted once written.
    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}
